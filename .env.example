# Mobile app (EXPO_PUBLIC_* only — never put secrets here)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx
EXPO_PUBLIC_PRIVACY_URL=https://virallens.app/privacy
EXPO_PUBLIC_TERMS_URL=https://virallens.app/terms

# Supabase Edge Function secrets (set via `supabase secrets set`)
# GEMINI_API_KEY=
# REVENUECAT_WEBHOOK_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=  (auto-injected in Edge Functions)
